# In order to clean up remaining sockets (ControlMaster auto) during the
# computer's suspend, I also added this cleanup script:
#
#     #!/bin/sh
#     # /usr/lib/systemd/system-sleep/ssh-mux-cleanup
#     # Cleanly close all ssh ControlMaster sockets before suspend,
#     # so we never resume with a stale mux socket.
#     if [ "$1" = "pre" ]; then
#         for sock in /home/chryssoc/.ssh/cm-*; do
#             [ -S "$sock" ] && ssh -o ControlPath="$sock" -O exit placeholder 2>/dev/null
#         done
#     fi
#
#   And then:
#   sudo chmod 755 /usr/lib/systemd/system-sleep/ssh-mux-cleanup
#
#
Host name_of_workstation
    HostName 10.10.10.10
    User my_user_name
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 4h
    ServerAliveInterval 15
    ServerAliveCountMax 2
    Compression no
    GSSAPIAuthentication no